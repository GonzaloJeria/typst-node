{
  "name": "@gjeria/html-to-typst",
  "version": "0.1.0",
  "description": "Transpile HTML and CSS (cascade, paged media, tables, flex/grid, backgrounds, columns) to Typst source.",
  "keywords": [
    "typst",
    "html",
    "css",
    "transpiler",
    "pdf"
  ],
  "author": "Gonzalo Jeria (https://github.com/GonzaloJeria)",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/GonzaloJeria/typst-node.git",
    "directory": "packages/html-to-typst"
  },
  "homepage": "https://github.com/GonzaloJeria/typst-node/tree/main/packages/html-to-typst#readme",
  "bugs": "https://github.com/GonzaloJeria/typst-node/issues",
  "sideEffects": false,
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "source": "./src/index.ts",
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "engines": {
    "node": ">=20.19"
  },
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc -p tsconfig.json"
  },
  "dependencies": {
    "parse5": "^8.0.1"
  },
  "publishConfig": {
    "access": "public",
    "exports": {
      ".": {
        "import": {
          "types": "./dist/index.d.ts",
          "default": "./dist/index.js"
        },
        "require": {
          "types": "./dist/index.d.cts",
          "default": "./dist/index.cjs"
        }
      }
    }
  }
}
