    let c6 = par("$100")
    let c7 = par("$100")
    let c8 = par("Licencias [anual]")
    let c9 = par("2")
    let c10 = par("$50")
    let c11 = par("$100")
    let c12 = par("Descuento")
    let c13 = par("-$10")
    let c14 = par("Total")
