    let m1 = (c1, c5, c9).fold(0pt, (a, c) => calc.max(a, measure(c).width)) + 3pt + 3pt
    let m2 = (c2, c6, c10).fold(0pt, (a, c) => calc.max(a, measure(c).width)) + 3pt + 3pt
    let m3 = (c3, c7, c11, c13, c15).fold(0pt, (a, c) => calc.max(a, measure(c).width)) + 3pt + 3pt
    let need = m1 + m2 + m3
    let free = size.width - need - (50% * size.width)
    let cols = if free >= 0pt and need > 0pt { (50%, m1 + free * (m1 / need), m2 + free * (m2 / need), m3 + free * (m3 / need),) } else { (50%, auto, auto, auto) }
    table(columns: cols, stroke: 0.5pt + rgb("#999999"), inset: (top: 3.25pt, right: 3pt, bottom: 3.25pt, left: 3pt), table.header(repeat: true, table.cell(align: center, fill: rgb("#f0f3f7"), c0), table.cell(align: center, fill: rgb("#f0f3f7"), c1), table.cell(align: center, fill: rgb("#f0f3f7"), c2), table.cell(align: center, fill: rgb("#f0f3f7"), c3)), c4, table.cell(align: right, c5), table.cell(align: right, c6), table.cell(align: right, c7), table.cell(rowspan: 2, fill: rgb("#fafafa"), c8), table.cell(align: right, fill: rgb("#fafafa"), c9), table.cell(align: right, fill: rgb("#fafafa"), c10), table.cell(align: right, fill: rgb("#fafafa"), c11), table.cell(colspan: 2, align: right, c12), table.cell(align: right, c13), table.footer(table.cell(colspan: 3, align: right, c14), table.cell(align: right, c15)))
  })
