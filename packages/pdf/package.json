{
  "name": "@gjeria/typst-html-pdf",
  "version": "0.2.1",
  "description": "HTML/CSS to PDF in Node.js without Chromium, powered by Typst.",
  "keywords": [
    "pdf",
    "html-to-pdf",
    "typst",
    "puppeteer-alternative",
    "invoice",
    "report",
    "tailwind"
  ],
  "author": "Gonzalo Jeria (https://github.com/GonzaloJeria)",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/GonzaloJeria/typst-node.git",
    "directory": "packages/pdf"
  },
  "homepage": "https://github.com/GonzaloJeria/typst-node/tree/main/packages/pdf#readme",
  "bugs": "https://github.com/GonzaloJeria/typst-node/issues",
  "sideEffects": false,
  "files": [
    "dist",
    "fonts",
    "README.md",
    "LICENSE"
  ],
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "source": "./src/index.ts",
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "engines": {
    "node": ">=20.19"
  },
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc -p tsconfig.json",
    "bench": "node bench.mjs"
  },
  "dependencies": {
    "@gjeria/html-to-typst": "workspace:^",
    "@gjeria/typst-compiler": "workspace:^",
    "tailwindcss": "^4.3.3"
  },
  "devDependencies": {
    "parse5": "^8.0.1"
  },
  "publishConfig": {
    "access": "public",
    "exports": {
      ".": {
        "import": {
          "types": "./dist/index.d.ts",
          "default": "./dist/index.js"
        },
        "require": {
          "types": "./dist/index.d.cts",
          "default": "./dist/index.cjs"
        }
      }
    }
  }
}
