{
  "name": "@typdf/pdf",
  "version": "0.3.0",
  "description": "HTML/CSS and Handlebars + Tailwind templates to PDF in Node.js without Chromium, powered by Typst. CLI with live preview.",
  "keywords": [
    "pdf",
    "html-to-pdf",
    "typst",
    "puppeteer-alternative",
    "templates",
    "handlebars",
    "tailwind",
    "invoice",
    "report"
  ],
  "author": "Gonzalo Jeria (https://github.com/GonzaloJeria)",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/GonzaloJeria/typst-node.git",
    "directory": "packages/pdf"
  },
  "homepage": "https://github.com/GonzaloJeria/typst-node/tree/main/packages/pdf#readme",
  "bugs": "https://github.com/GonzaloJeria/typst-node/issues",
  "sideEffects": false,
  "files": [
    "dist",
    "fonts",
    "README.md",
    "LICENSE"
  ],
  "bin": {
    "typdf": "./dist/cli.js"
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "source": "./src/index.ts",
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "engines": {
    "node": ">=20.19"
  },
  "scripts": {
    "build": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\" && tsup",
    "typecheck": "tsc -p tsconfig.json",
    "bench": "node bench.mjs"
  },
  "dependencies": {
    "@typdf/html-to-typst": "workspace:^",
    "handlebars": "^4.7.8",
    "tailwindcss": "^4.3.3"
  },
  "devDependencies": {
    "parse5": "^8.0.1"
  },
  "optionalDependencies": {
    "@typdf/sidecar-linux-x64": "workspace:*",
    "@typdf/sidecar-linux-arm64": "workspace:*",
    "@typdf/sidecar-darwin-x64": "workspace:*",
    "@typdf/sidecar-darwin-arm64": "workspace:*",
    "@typdf/sidecar-win32-x64": "workspace:*"
  },
  "publishConfig": {
    "access": "public",
    "exports": {
      ".": {
        "import": {
          "types": "./dist/index.d.ts",
          "default": "./dist/index.js"
        },
        "require": {
          "types": "./dist/index.d.cts",
          "default": "./dist/index.cjs"
        }
      }
    }
  }
}
