{
  "name": "@gjeria/typst-sidecar-darwin-x64",
  "version": "0.1.0",
  "description": "typst-sidecar binary for darwin-x64 (x86_64-apple-darwin), used by @gjeria/typst-compiler.",
  "author": "Gonzalo Jeria (https://github.com/GonzaloJeria)",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/GonzaloJeria/typst-node.git",
    "directory": "npm/typst-sidecar-darwin-x64"
  },
  "os": [
    "darwin"
  ],
  "cpu": [
    "x64"
  ],
  "bin": {
    "typst-sidecar": "bin/typst-sidecar"
  },
  "files": [
    "bin",
    "LICENSE",
    "README.md"
  ],
  "preferUnplugged": true,
  "scripts": {
    "prepublishOnly": "node -e \"require('fs').accessSync('bin/typst-sidecar')\""
  },
  "publishConfig": {
    "access": "public"
  },
  "typstSidecar": {
    "target": "x86_64-apple-darwin",
    "binary": "bin/typst-sidecar"
  }
}
