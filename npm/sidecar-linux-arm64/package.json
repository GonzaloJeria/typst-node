{
  "name": "@typdf/sidecar-linux-arm64",
  "version": "0.3.0",
  "description": "typst-sidecar binary for linux-arm64 (aarch64-unknown-linux-musl), used by @typdf/pdf.",
  "author": "Gonzalo Jeria (https://github.com/GonzaloJeria)",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/GonzaloJeria/typst-node.git",
    "directory": "npm/sidecar-linux-arm64"
  },
  "os": [
    "linux"
  ],
  "cpu": [
    "arm64"
  ],
  "bin": {
    "typst-sidecar": "bin/typst-sidecar"
  },
  "files": [
    "bin",
    "LICENSE",
    "README.md"
  ],
  "preferUnplugged": true,
  "scripts": {
    "prepublishOnly": "node -e \"require('fs').accessSync('bin/typst-sidecar')\""
  },
  "publishConfig": {
    "access": "public"
  },
  "typstSidecar": {
    "target": "aarch64-unknown-linux-musl",
    "binary": "bin/typst-sidecar"
  }
}
