{
  "name": "typst-node-monorepo",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": ">=20.19"
  },
  "scripts": {
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck",
    "test": "vitest run",
    "test:watch": "vitest",
    "changeset": "changeset",
    "release": "pnpm build && changeset publish",
    "sidecar:build": "node scripts/build-sidecar.mjs",
    "test:chrome": "vitest run --root packages/pdf --config vitest.chrome.config.ts"
  },
  "devDependencies": {
    "@changesets/cli": "^2.29.0",
    "@tailwindcss/cli": "^4.3.3",
    "@types/node": "^22.0.0",
    "bootstrap": "^5.3.8",
    "playwright-core": "~1.56.1",
    "tailwindcss": "^4.3.3",
    "tsup": "^8.5.0",
    "typescript": "^5.9.0",
    "vitest": "^3.2.0"
  }
}
